digraph ER {
rankdir=LR; nodesep=0.5; ranksep=1.2; splines=true; bgcolor="white";
node [shape=plain fontname="Helvetica" fontsize=11]; edge [fontname="Helvetica" fontsize=9 color="#475569" dir=both];
labelloc=t; fontsize=20; label="OrbitalOps - Satellite Mission System ER Diagram";
"users" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0"><B>users</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">email UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">password_hash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">role</FONT></TD></TR></TABLE>>];
"ground_stations" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0"><B>ground_stations</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">name UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">country</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">region</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">latitude</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">longitude</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">is_active</FONT></TD></TR></TABLE>>];
"launch_vehicles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0"><B>launch_vehicles</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">name UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">manufacturer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">payload_capacity_kg</FONT></TD></TR></TABLE>>];
"launches" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#ede9fe"><B>launches</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">code UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">vehicle_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">site</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">launch_date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">created_by FK</FONT></TD></TR></TABLE>>];
"satellites" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#dbeafe"><B>satellites</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">code UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">norad_id UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">orbit</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">battery_pct</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">altitude_km</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">signal_dbm</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">temperature_c</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">launch_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">ground_station_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">specs (JSONB)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">last_contact</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">deleted_at</FONT></TD></TR></TABLE>>];
"missions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#fef3c7"><B>missions</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">code UK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">objective</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">start_date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">end_date</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">owner_id FK</FONT></TD></TR></TABLE>>];
"mission_satellites" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0"><B>mission_satellites</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">mission_id PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">satellite_id PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">role</FONT></TD></TR></TABLE>>];
"mission_phases" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0"><B>mission_phases</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">mission_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">seq</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">status</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">completed_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">UK (mission_id, seq)</FONT></TD></TR></TABLE>>];
"mission_progress" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0"><B>mission_progress</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">mission_id PK,FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">log_date PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">progress_pct</FONT></TD></TR></TABLE>>];
"contact_logs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0"><B>contact_logs</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">satellite_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">ground_station_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">started_at</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">duration_s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">success</FONT></TD></TR></TABLE>>];
"telemetry (partitioned by month)" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#dcfce7"><B>telemetry (partitioned by month)</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id, recorded_at PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">satellite_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">altitude_km</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">battery_pct</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">signal_dbm</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">temperature_c</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">velocity_kms</FONT></TD></TR></TABLE>>];
"alerts" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#fee2e2"><B>alerts</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">satellite_id FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">severity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">title</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">message</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">acknowledged</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">acknowledged_by FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">created_at</FONT></TD></TR></TABLE>>];
"audit_log" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD BGCOLOR="#e2e8f0"><B>audit_log</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT COLOR="#b91c1c">id PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">table_name</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">operation</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">row_id</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">old_data</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">new_data</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">changed_by</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#0f172a">changed_at</FONT></TD></TR></TABLE>>];
"launch_vehicles" -> "launches" [arrowtail=tee arrowhead=crowodot label="1:N"];
"launches" -> "satellites" [arrowtail=tee arrowhead=crowodot label="1:N"];
"ground_stations" -> "satellites" [arrowtail=tee arrowhead=crowodot label="1:N"];
"satellites" -> "mission_satellites" [arrowtail=tee arrowhead=crowodot label="1:N"];
"missions" -> "mission_satellites" [arrowtail=tee arrowhead=crowodot label="1:N"];
"missions" -> "mission_phases" [arrowtail=tee arrowhead=crowodot label="1:N"];
"missions" -> "mission_progress" [arrowtail=tee arrowhead=crowodot label="1:N"];
"satellites" -> "telemetry (partitioned by month)" [arrowtail=tee arrowhead=crowodot label="1:N"];
"satellites" -> "alerts" [arrowtail=tee arrowhead=crowodot label="1:N"];
"satellites" -> "contact_logs" [arrowtail=tee arrowhead=crowodot label="1:N"];
"ground_stations" -> "contact_logs" [arrowtail=tee arrowhead=crowodot label="1:N"];
"users" -> "missions" [arrowtail=tee arrowhead=crowodot label="owns 1:N"];
"users" -> "launches" [arrowtail=tee arrowhead=crowodot label="creates 1:N"];
"users" -> "alerts" [arrowtail=tee arrowhead=crowodot label="acknowledges 1:N"];
}
